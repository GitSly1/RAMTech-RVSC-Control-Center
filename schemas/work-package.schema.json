{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ramtech.local/rvsc/work-package.schema.json",
  "title": "RVSC Work Package",
  "type": "object",
  "required": [
    "schema_version",
    "work_package_id",
    "title",
    "target_repositories",
    "base_branch",
    "work_branch",
    "allowed_paths",
    "objective",
    "acceptance_criteria",
    "validation",
    "handoff"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "work_package_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "status": {
      "type": "string",
      "enum": ["draft", "ready", "in_progress", "blocked", "review", "accepted", "rejected", "closed"]
    },
    "assigned_role": {"type": "string"},
    "target_repositories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[^/]+/[^/]+$"}
    },
    "base_branch": {"type": "string", "minLength": 1},
    "work_branch": {"type": "string", "pattern": "^rvsc/"},
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "forbidden_paths": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "objective": {"type": "string", "minLength": 1},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "deliverables": {"type": "array", "items": {"type": "string"}},
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "validation": {
      "type": "object",
      "required": ["required_checks"],
      "properties": {
        "required_checks": {"type": "array", "items": {"type": "string"}},
        "regression_required": {"type": "boolean"},
        "human_uat_required": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "handoff": {
      "type": "object",
      "required": ["report_files_changed", "report_validation", "report_risks", "report_commit_or_pr"],
      "properties": {
        "report_files_changed": {"type": "boolean", "const": true},
        "report_validation": {"type": "boolean", "const": true},
        "report_risks": {"type": "boolean", "const": true},
        "report_commit_or_pr": {"type": "boolean", "const": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
